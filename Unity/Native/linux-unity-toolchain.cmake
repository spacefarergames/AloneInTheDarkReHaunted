set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(FITD_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(UNITY_CROSS_ROOT "${FITD_ROOT}/build/unity-toolchains" CACHE PATH "Extracted official Unity compiler/sysroot")
find_program(FITD_CLANG_EXECUTABLE clang REQUIRED)
get_filename_component(FITD_CLANG_DEFAULT_BIN "${FITD_CLANG_EXECUTABLE}" DIRECTORY)
set(FITD_CLANG_BIN "${FITD_CLANG_DEFAULT_BIN}" CACHE PATH "Modern Clang and lld directory (Clang 11+ required)")
set(CMAKE_C_COMPILER "${FITD_CLANG_BIN}/clang.exe")
set(CMAKE_CXX_COMPILER "${FITD_CLANG_BIN}/clang++.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-glibc2.17-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-glibc2.17-linux-gnu)
set(CMAKE_SYSROOT "${UNITY_CROSS_ROOT}/sysroot/payload")
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${CMAKE_SYSROOT}/usr -fuse-ld=lld")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=${CMAKE_SYSROOT}/usr -fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
