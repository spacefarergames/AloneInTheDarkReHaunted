build ThirdParty/SDL/libSDL_uclibc.a: C_STATIC_LIBRARY_LINKER__SDL_uclibc_Release ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_atan2.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_exp.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_fmod.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_log.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_log10.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_pow.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_rem_pio2.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/e_sqrt.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/k_cos.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/k_rem_pio2.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/k_sin.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/k_tan.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_atan.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_copysign.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_cos.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_fabs.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_floor.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_isinf.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_isinff.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_isnan.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_isnanf.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_modf.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_scalbn.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_sin.c.o ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir/src/libm/s_tan.c.o
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  OBJECT_DIR = ThirdParty/SDL/CMakeFiles/SDL_uclibc.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = ThirdParty/SDL/libSDL_uclibc.a
  TARGET_PDB = SDL_uclibc.a.dbg


#############################################
# Utility command for edit_cache

build ThirdParty/SDL/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/d/FITD/build/linux/ThirdParty/SDL && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build ThirdParty/SDL/edit_cache: phony ThirdParty/SDL/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build ThirdParty/SDL/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/d/FITD/build/linux/ThirdParty/SDL && /usr/bin/cmake --regenerate-during-build -S/mnt/d/FITD -B/mnt/d/FITD/build/linux
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build ThirdParty/SDL/rebuild_cache: phony ThirdParty/SDL/CMakeFiles/rebuild_cache.util


