# =============================================================================
# Object build statements for EXECUTABLE target Fitd


#############################################
# Order-only phony target for Fitd

build cmake_object_order_depends_target_Fitd: phony || cmake_object_order_depends_target_FitdLib cmake_object_order_depends_target_SDL3-static cmake_object_order_depends_target_bgfx cmake_object_order_depends_target_bimg cmake_object_order_depends_target_bx cmake_object_order_depends_target_soloud cmake_object_order_depends_target_zlibstatic

build Fitd/CMakeFiles/Fitd.dir/fitd.cpp.o: CXX_COMPILER__Fitd_unscanned_Release /mnt/d/FITD/Fitd/fitd.cpp || cmake_object_order_depends_target_Fitd
  DEFINES = -DBGFX_CONFIG_DEBUG_ANNOTATION=0 -DBGFX_CONFIG_MULTITHREADED=1 -DBX_CONFIG_DEBUG=0
  DEP_FILE = Fitd/CMakeFiles/Fitd.dir/fitd.cpp.o.d
  FLAGS = -DBX_CONFIG_DEBUG=0 -O3 -DNDEBUG -std=c++17
  INCLUDES = -I/mnt/d/FITD/Fitd/. -I/mnt/d/FITD/FitdLib -I/mnt/d/FITD/ThirdParty/bgfx.cmake/bgfx/include -I/mnt/d/FITD/build/linux/ThirdParty/SDL/include-revision -I/mnt/d/FITD/ThirdParty/SDL/include
  OBJECT_DIR = Fitd/CMakeFiles/Fitd.dir
  OBJECT_FILE_DIR = Fitd/CMakeFiles/Fitd.dir


# =============================================================================
# Link build statements for EXECUTABLE target Fitd


#############################################
# Link the executable Fitd/Tatou

build Fitd/Tatou: CXX_EXECUTABLE_LINKER__Fitd_Release Fitd/CMakeFiles/Fitd.dir/fitd.cpp.o | FitdLib/libFitdLib.a ThirdParty/bgfx.cmake/cmake/bgfx/libbgfx.a zlib/zlib-build/libz.a ThirdParty/SDL/libSDL3.a ThirdParty/soloud.cmake/libsoloud.a /usr/lib/x86_64-linux-gnu/libX11.so /usr/lib/x86_64-linux-gnu/libXext.so /usr/lib/x86_64-linux-gnu/libX11.so /usr/lib/x86_64-linux-gnu/libXext.so ThirdParty/bgfx.cmake/cmake/bimg/libbimg.a ThirdParty/bgfx.cmake/cmake/bx/libbx.a /usr/lib/x86_64-linux-gnu/libOpenGL.so /usr/lib/x86_64-linux-gnu/libGLX.so /usr/lib/x86_64-linux-gnu/libGLU.so || FitdLib/libFitdLib.a ThirdParty/SDL/libSDL3.a ThirdParty/bgfx.cmake/cmake/bgfx/libbgfx.a ThirdParty/bgfx.cmake/cmake/bimg/libbimg.a ThirdParty/bgfx.cmake/cmake/bx/libbx.a ThirdParty/soloud.cmake/libsoloud.a zlib/zlib-build/libz.a
  FLAGS = -DBX_CONFIG_DEBUG=0 -O3 -DNDEBUG
  LINK_FLAGS = -pthread
  LINK_LIBRARIES = FitdLib/libFitdLib.a  ThirdParty/bgfx.cmake/cmake/bgfx/libbgfx.a  zlib/zlib-build/libz.a  ThirdParty/SDL/libSDL3.a  ThirdParty/soloud.cmake/libsoloud.a  /usr/lib/x86_64-linux-gnu/libX11.so  /usr/lib/x86_64-linux-gnu/libXext.so  -lGL  -ldl  -lrt  -lwayland-egl  /usr/lib/x86_64-linux-gnu/libX11.so  /usr/lib/x86_64-linux-gnu/libXext.so  ThirdParty/bgfx.cmake/cmake/bimg/libbimg.a  ThirdParty/bgfx.cmake/cmake/bx/libbx.a  /usr/lib/x86_64-linux-gnu/libOpenGL.so  /usr/lib/x86_64-linux-gnu/libGLX.so  /usr/lib/x86_64-linux-gnu/libGLU.so  -lm  -ldl  -lrt
  OBJECT_DIR = Fitd/CMakeFiles/Fitd.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = Fitd/Tatou
  TARGET_PDB = Tatou.dbg


#############################################
# Utility command for edit_cache

build Fitd/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/d/FITD/build/linux/Fitd && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build Fitd/edit_cache: phony Fitd/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build Fitd/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/d/FITD/build/linux/Fitd && /usr/bin/cmake --regenerate-during-build -S/mnt/d/FITD -B/mnt/d/FITD/build/linux
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build Fitd/rebuild_cache: phony Fitd/CMakeFiles/rebuild_cache.util

