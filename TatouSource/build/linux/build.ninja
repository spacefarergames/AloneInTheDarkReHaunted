# =============================================================================
# Object build statements for SHARED_LIBRARY target zlib


#############################################
# Order-only phony target for zlib

build cmake_object_order_depends_target_zlib: phony || zlib/zlib-build/CMakeFiles/zlib.dir

build zlib/zlib-build/CMakeFiles/zlib.dir/adler32.c.o: C_COMPILER__zlib_unscanned_Release /mnt/d/FITD/ThirdParty/zlib/adler32.c || cmake_object_order_depends_target_zlib
  DEFINES = -DZLIB_DLL -D_LARGEFILE64_SOURCE=1
  DEP_FILE = zlib/zlib-build/CMakeFiles/zlib.dir/adler32.c.o.d
  FLAGS = -O3 -DNDEBUG -fPIC
  INCLUDES = -I/mnt/d/FITD/build/linux/zlib/zlib-build -I/mnt/d/FITD
  OBJECT_DIR = zlib/zlib-build/CMakeFiles/zlib.dir
  OBJECT_FILE_DIR = zlib/zlib-build/CMakeFiles/zlib.dir

