	cd /mnt/d/FITD/build/linux-native-tools && $(MAKE) $(MAKESILENT) -f ThirdParty/soloud.cmake/CMakeFiles/soloud.dir/build.make ThirdParty/soloud.cmake/CMakeFiles/soloud.dir/soloud/src/core/soloud_thread.cpp.o
